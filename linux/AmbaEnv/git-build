local_daily(){
	echo "Daily Build"
	RELEASE_FIRMWARE=0
	LATESTUPADTEINFOFILE="latest.cec"

	POST_PROTOCOL=$(jq -r ".project[] | select(.name == \"${PROJECT}\").uploadSrv.protocol" ${CONFIG_FILE}) 
	POST_URL=$(jq -r ".project[] | select(.name == \"${PROJECT}\").uploadSrv.upload_url" ${CONFIG_FILE}) 
			POST_DAILYPATH=$(jq -r ".project[] | select(.name == \"${PROJECT}\").uploadSrv.dailyPath" ${CONFIG_FILE}) 
			POST_USERNAME=$(jq -r ".project[] | select(.name == \"${PROJECT}\").uploadSrv.username" ${CONFIG_FILE}) 

			POST_PASSWORD=$(jq -r ".project[] | select(.name == \"${PROJECT}\").uploadSrv.password" ${CONFIG_FILE}) 
	echo "Fetch the latest version info:"
		curl -u "${POST_USERNAME}:${POST_PASSWORD}" ${POST_PROTOCOL}://${POST_URL}/${POST_DAILYPATH}/${LATESTUPADTEINFOFILE} -o ${LATESTUPADTEINFOFILE}
	[ $? -eq 0 ] && LATEST_HASH=`cat ${LATESTUPADTEINFOFILE}` || exit 100 	
	NOW_HASH=`git ls-remote ${GIT_REPO} ${MAIN_BRANCHNAME} | awk '{print $1}'`
	if [ "$NOW_HASH" != "$LATEST_HASH" ]; then
		local_smt
		if [ $? -eq 0 ]; then 
			curl -u "${POST_USERNAME}:${POST_PASSWORD}" ${POST_PROTOCOL}://${POST_URL}/${POST_DAILYPATH}/${ZIP_ARCIHEVENAME} -T ${ZIP_ARCIHEVENAME}
		
			echo "${NOW_HASH}" > ${LATESTUPADTEINFOFILE}
			curl -u "${POST_USERNAME}:${POST_PASSWORD}" ${POST_PROTOCOL}://${POST_URL}/${POST_DAILYPATH}/${LATESTUPADTEINFOFILE} -T ${LATESTUPADTEINFOFILE}
		fi
	else 	
		echo "Daily build not necessary. Because latest was Built"
	fi	
	
}

local_check_method()
{
	if [ "$(type -t local_${METHOD})" != "function" ]; then
		echo "Not supported method: ${METHOD} !"
		exit 4
	else
		eval local_${METHOD}
	fi
	
}
