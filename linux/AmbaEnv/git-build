#!/bin/bash
# Smt: Factory production firmware 
# Hotfix: Fix magnifacant change invole in main stream after Smt firmware.
# Trial: For specific file 
# Daily: For Daily build use


GREENTEXTFONT='\033[0;32m'
NCTEXTFONT='\033[0m'
REDTEXTFONT='\033[0;31m'

CONFIG_FILE="/etc/cec.json"
METHOD="trial"
MAIN_BRANCHNAME="main"
#REL_DOC_NAME="Larnaca2_stress_test_guide.txt"
RELEASE_FIRMWARE=0

usage (){
cat <<EOF
Usage: git cec [OPTIONS] <project> [Root Directory]

Options:
  -m, --method <smt|hotfix|triali|none>      (required)
  -b, --branch <branch name> (default: main)
  -R, --release	(Default: No)
  -h, --help           Show help
EOF
}

get_git_username_password(){
	echo "`jq -r '"\(.username):\(.password)"' ${CONFIG_FILE}`"
}

get_git_repo_mainstream(){
	local branch=$(jq -r ".project[] | select(.name == \"${1}\").mainStream" ${CONFIG_FILE})
	if [[ "$branch" == "null" || "branch" == "" ]]; then
		exit 9
	else
		MAIN_BRANCHNAME=$branch
	fi
}
get_git_clone_remote_target()
{
	local url=$(jq -r ".project[] | select(.name == \"${1}\").path" ${CONFIG_FILE})
	if [[ "$url" == "null" || "$url" == "" ]]; then
		exit 9
	else
		PROJECT=$1
		GIT_REPO="${url/http:\/\//http://`get_git_username_password`@}"
	fi
}
	
get_target_rootdirname(){
	datetime="$(date +%Y%m%d%H%M)"
	local url=$(jq -r ".project[] | select(.name == \"${PROJECT}\").path" ${CONFIG_FILE})
	name=${url##*/}
	echo "${name//.git}_${datetime}"
}
get_args (){
	OPTS=$(getopt \
		-l method:branch:help \
		-n 'git cec' -- m:b:hR "$@"
	)

	eval set -- "$OPTS"
	
	while true; do
    case "$1" in
        -m|--method)
            METHOD="${2,,}"
            shift 2
            ;;
        -b|--branch)
            MAIN_BRANCHNAME="${2,,}"
            shift 2
            ;;
       	-R|--release)
		RELEASE_FIRMWARE=1
		shift 1
		;;
        -h|--help)
            usage
            exit 0
            ;;
        --)
            shift
            break
            ;;
        *)
            break
            ;;
    esac
done
get_git_clone_remote_target "$1"
get_git_repo_mainstream "$1"
ROOTDIR=${2-`get_target_rootdirname`}
}

print_info(){
	echo ""
	echo "================================="
	echo " PROJECT = ${PROJECT}"
	echo " Root Dir name= ${ROOTDIR}"
	echo " Root Dir Path= `dirname ${ROOTDIR}`"
	echo " Build Method= ${METHOD}"
	echo " GIT REMOTE PATH= ${GIT_REPO}"
	echo " GIT BRANCH NAME= ${MAIN_BRANCHNAME}"
	echo "================================="
	echo ""
}

local_check_rootdir (){
	[  -d ${ROOTDIR} ] && exit 7 
	[ ! -d ${ROOTDIR%/*} ] && mkdir -p ${ROOTDIR%/*} 
}

local_hotfix()
{
	BOARD_TAG="`cat .soc`_`cat .board`"
	BOARDS_PATH="./ambarella/boards/$BOARD_TAG"
	if [ -d "$BOARDS_PATH" ]; then 
		cd ${BOARDS_PATH}
	else 
		echo "Cannot find ${BOARDS_PATH} !"
		exit 1
	fi
	
	if [ -e project.sh ]; then
		./project.sh hotfix
	else 
		echo "Cannot exist project.sh!"
		exit 7
	fi
	cd -
	FW_NAME_FILE="ambarella/out/amba_out/${BOARD_TAG}/sysroot/etc/fw_version"
	if [ -e "${FW_NAME_FILE}" ]; then 
	fw_name="`cat ${FW_NAME_FILE}`.bin"
	cp $(ls -S1 ambarella/out/amba_out/${BOARD_TAG}/firmware/*.bin | head -1) ${fw_name}
	fi
}

